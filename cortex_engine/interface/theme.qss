/* Cortex Gaming Engine — tema oscuro con acentos verdes (independiente) */

* {
    font-family: "Inter", "Noto Sans", "Cantarell", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #d7f3e3;
}

QMainWindow, QDialog {
    background-color: #070d0a;
}

QWidget#cortexRoot {
    background-color: #070d0a;
}

/* Fondo base: las tarjetas y controles lo sobrescriben más abajo. */
QWidget {
    background-color: #070d0a;
}

QLabel, QCheckBox {
    background-color: transparent;
}

QStackedWidget, QWidget#pageContent {
    background-color: transparent;
}

QToolTip {
    background-color: #0d1a13;
    color: #d7f3e3;
    border: 1px solid #1f4732;
    padding: 5px 7px;
}

/* ---------------- Cabecera ---------------- */

QFrame#cortexHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0a1710, stop:1 #07110c);
    border-bottom: 1px solid #173123;
}

QLabel#cortexLogo {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #46ffab;
}

QLabel#cortexTagline {
    color: #6f9c83;
    font-size: 11px;
    letter-spacing: 1px;
}

QLabel#statusPill {
    background-color: #0e2a1c;
    border: 1px solid #1f5c3d;
    border-radius: 10px;
    color: #58f0a0;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ---------------- Barra lateral ---------------- */

QListWidget#cortexSidebar {
    background-color: #09120d;
    border: none;
    border-right: 1px solid #14281d;
    padding: 14px 8px;
    outline: none;
}

QListWidget#cortexSidebar::item {
    color: #86ab95;
    padding: 11px 14px;
    margin: 2px 4px;
    border-radius: 8px;
}

QListWidget#cortexSidebar::item:hover {
    background-color: #0f2017;
    color: #d7f3e3;
}

QListWidget#cortexSidebar::item:selected {
    background-color: #112a1d;
    color: #eafff3;
    border-left: 3px solid #35e08a;
}

/* ---------------- Títulos y textos ---------------- */

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #eafff3;
}

QLabel#pageSubtitle {
    color: #7ea892;
    font-size: 12px;
}

QLabel#sectionTitle {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #6fe6a6;
}

QLabel#muted {
    color: #7ea892;
}

QLabel#metricValue {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 22px;
    font-weight: 700;
    color: #eafff3;
}

QLabel#metricDetail {
    color: #7ea892;
    font-size: 11px;
}

QLabel#accentValue {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    color: #46ffab;
}

/* ---------------- Tarjetas ---------------- */

QFrame#cortexCard, QFrame#metricTile, QFrame#profileCard {
    background-color: #0c1711;
    border: 1px solid #1a3828;
    border-radius: 12px;
}

QFrame#metricTile {
    background-color: #0b150f;
}

QFrame#profileCard:hover {
    border-color: #2a6b48;
}

QFrame#profileCard[active="true"] {
    background-color: #0e2016;
    border: 1px solid #35e08a;
}

QFrame#profileCard[active="false"] {
    background-color: #0c1711;
    border: 1px solid #1a3828;
}

QLabel#profileName {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#profileTagline {
    color: #a9cdb8;
    font-size: 12px;
}

QLabel#profileDesc {
    color: #7ea892;
    font-size: 11px;
}

/* ---------------- Botones ---------------- */

QPushButton {
    background-color: #10231a;
    border: 1px solid #1f4a33;
    border-radius: 8px;
    color: #c9ffe0;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #173324;
    border-color: #2b6b48;
}

QPushButton:pressed {
    background-color: #0c1a13;
}

QPushButton:disabled {
    color: #55705f;
    border-color: #173023;
    background-color: #0a140f;
}

QPushButton#accentButton {
    background-color: #17a866;
    border: 1px solid #35e08a;
    color: #04130b;
}

QPushButton#accentButton:hover {
    background-color: #1fc47a;
}

QPushButton#restoreButton {
    background-color: transparent;
    border: 1px solid #6b2f36;
    color: #ff9fa7;
}

QPushButton#restoreButton:hover {
    background-color: #241014;
}

/* ---------------- Controles ---------------- */

QCheckBox {
    color: #b6d7c3;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #2a5c40;
    background-color: #0a140f;
}

QCheckBox::indicator:checked {
    background-color: #17a866;
    border-color: #35e08a;
}

QSpinBox, QComboBox, QLineEdit {
    background-color: #0a140f;
    border: 1px solid #1f4a33;
    border-radius: 7px;
    padding: 5px 8px;
    color: #d7f3e3;
    selection-background-color: #17a866;
}

QSpinBox:focus, QComboBox:focus, QLineEdit:focus {
    border-color: #35e08a;
}

/* ---------------- Barras de progreso ---------------- */

QProgressBar {
    background-color: #0a140f;
    border: 1px solid #173023;
    border-radius: 5px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #28c47a;
    border-radius: 4px;
}

/* ---------------- Actividad ---------------- */

QListWidget#activityList {
    background-color: #08110c;
    border: 1px solid #173023;
    border-radius: 10px;
    padding: 6px;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    outline: none;
}

QListWidget#activityList::item {
    color: #a9cdb8;
    padding: 4px 6px;
    border-bottom: 1px solid #0f2017;
}

QListWidget#activityList::item:selected {
    background-color: #112a1d;
    color: #eafff3;
}

/* ---------------- Desplazamiento ---------------- */

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #1f4a33;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2b6b48;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QStatusBar {
    background-color: #08110c;
    color: #6f9c83;
    border-top: 1px solid #14281d;
}
