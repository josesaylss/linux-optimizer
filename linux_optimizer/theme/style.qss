/* Linux Optimizer — tema oscuro profesional */

* {
    font-family: "Inter", "Noto Sans", "Cantarell", "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #0f1218;
    color: #dfe4ee;
    selection-background-color: #2f6df6;
    selection-color: #ffffff;
}

/* ---------- Ventana principal ---------- */

QMainWindow, QDialog {
    background-color: #0f1218;
}

QToolTip {
    background-color: #1a2030;
    color: #dfe4ee;
    border: 1px solid #2a3245;
    padding: 4px 6px;
}

/* ---------- Barra lateral ---------- */

QListWidget#sidebar {
    background-color: #10141c;
    border: none;
    border-right: 1px solid #1c2333;
    padding: 12px 6px;
    outline: none;
}

QListWidget#sidebar::item {
    color: #9aa4bb;
    padding: 11px 14px;
    margin: 2px 4px;
    border-radius: 8px;
}

QListWidget#sidebar::item:hover {
    background-color: #171d2b;
    color: #dfe4ee;
}

QListWidget#sidebar::item:selected {
    background-color: #1d2942;
    color: #ffffff;
    border-left: 3px solid #2f6df6;
}

/* ---------- Cabecera ---------- */

QLabel#headerTitle {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#headerSubtitle {
    color: #8b95ad;
    font-size: 12px;
}

/* ---------- Tarjetas ---------- */

QFrame#card, QFrame#statCard {
    background-color: #141a26;
    border: 1px solid #202940;
    border-radius: 12px;
}

QFrame#statCard:hover {
    border: 1px solid #2f6df6;
}

QLabel#cardTitle {
    color: #8b95ad;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QLabel#statValue {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#statSubtitle {
    color: #7d879d;
    font-size: 11px;
}

/* ---------- Botones ---------- */

QPushButton {
    background-color: #1a2130;
    color: #dfe4ee;
    border: 1px solid #29334a;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #212a3d;
    border-color: #3a4767;
}

QPushButton:pressed {
    background-color: #172032;
}

QPushButton:disabled {
    color: #5b657d;
    background-color: #131925;
    border-color: #1d2434;
}

QPushButton#primary {
    background-color: #2f6df6;
    border-color: #2f6df6;
    color: #ffffff;
}

QPushButton#primary:hover {
    background-color: #457ef8;
}

QPushButton#danger {
    background-color: #7a2434;
    border-color: #93303f;
    color: #ffd9df;
}

QPushButton#danger:hover {
    background-color: #93303f;
}

/* ---------- Inputs ---------- */

QLineEdit, QComboBox, QSpinBox {
    background-color: #131a27;
    border: 1px solid #29334a;
    border-radius: 8px;
    padding: 7px 10px;
    color: #dfe4ee;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #2f6df6;
}

QComboBox QAbstractItemView {
    background-color: #131a27;
    border: 1px solid #29334a;
    selection-background-color: #1d2942;
}

/* ---------- Tablas ---------- */

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background-color: #121826;
    border: 1px solid #202940;
    border-radius: 10px;
    gridline-color: #1a2233;
    alternate-background-color: #141b2b;
}

QHeaderView::section {
    background-color: #161d2c;
    color: #9aa4bb;
    border: none;
    border-bottom: 1px solid #202940;
    padding: 8px 10px;
    font-weight: 600;
}

QTableWidget::item, QListView::item {
    padding: 4px;
}

QTableWidget::item:selected, QListView::item:selected {
    background-color: #1d2942;
    color: #ffffff;
}

/* ---------- Barras de progreso ---------- */

QProgressBar {
    background-color: #131a27;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #2f6df6;
    border-radius: 5px;
}

/* ---------- Scrollbars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #2a3245;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3a4767;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 4px;
}

QScrollBar::handle:horizontal {
    background: #2a3245;
    border-radius: 4px;
    min-width: 30px;
}

/* ---------- Estado / barra inferior ---------- */

QStatusBar {
    background-color: #10141c;
    color: #8b95ad;
    border-top: 1px solid #1c2333;
}

/* ---------- Radio / Check ---------- */

QRadioButton, QCheckBox {
    spacing: 8px;
    padding: 4px 0;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #3a4767;
    background: #131a27;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background: #2f6df6;
    border-color: #2f6df6;
}

/* ---------- Texto de solo lectura ---------- */

QPlainTextEdit, QTextEdit {
    background-color: #10151f;
    border: 1px solid #202940;
    border-radius: 10px;
    color: #c6cdda;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 12px;
}

QLabel#severityOk   { color: #58d68d; }
QLabel#severityWarn { color: #f5b041; }
QLabel#severityCrit { color: #ff6b6b; }
QLabel#severityInfo { color: #7fb3ff; }
